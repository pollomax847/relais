# Copier en .env et remplir. Ce fichier est lu par docker compose.
# Chemins de l'ordinateur, repris tels quels dans le conteneur relais
SPORT_PROJET=/chemin/vers/le/projet
SPORT_HOME=/home/utilisateur
SPORT_MEDIA=/media/utilisateur
# Relais ne répond qu'à cet ordinateur. 0.0.0.0 : aussi aux appareils du réseau de la maison (choisir d'abord un mot de passe)
RELAIS_ECOUTE=127.0.0.1
